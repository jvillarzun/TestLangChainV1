# ═══════════════════════════════════════════════════════════════════════
# CONFIGURACIÓN MULTI-PROVEEDOR LLM (Gemini + OpenAI)
# ═══════════════════════════════════════════════════════════════════════

# ── API KEYS ─────────────────────────────────────────────────────────
# Google Gemini (GRATIS en AI Studio - https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# OpenAI (Requiere cuenta de pago - https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your_openai_api_key_here


# ── CONFIGURACIÓN DE PROVEEDORES ────────────────────────────────────

# 🏗️  ARCHITECT Agent (Diseño de Arquitectura)
# Opciones de proveedor: "gemini" o "openai"
LLM_PROVIDER_ARCH=gemini

# Opciones de modelo según proveedor:
#   Si LLM_PROVIDER_ARCH=gemini:
#     - gemini-2.5-flash (RECOMENDADO - gratis)
#     - gemini-2.5-pro
#     - gemini-1.5-flash
#   Si LLM_PROVIDER_ARCH=openai:
#     - gpt-4o-mini (económico)
#     - gpt-4o (más potente)
#     - gpt-4-turbo
LLM_MODEL_ARCH=gemini-2.5-flash


# 💻 DEV Agent (Generación de Código)
# Opciones de proveedor: "gemini" o "openai"
LLM_PROVIDER_DEV=gemini

# Opciones de modelo según proveedor:
#   Si LLM_PROVIDER_DEV=gemini:
#     - gemini-2.5-flash (RECOMENDADO - gratis + sigue bien las instrucciones)
#     - gemini-2.5-pro
#   Si LLM_PROVIDER_DEV=openai:
#     - gpt-4o-mini (rápido + económico)
#     - gpt-4o (mejor calidad de código)
LLM_MODEL_DEV=gemini-2.5-flash


# ═══════════════════════════════════════════════════════════════════════
# EJEMPLOS DE CONFIGURACIÓN
# ═══════════════════════════════════════════════════════════════════════

# Ejemplo 1: TODO CON GEMINI (100% gratis)
# LLM_PROVIDER_ARCH=gemini
# LLM_MODEL_ARCH=gemini-2.5-flash
# LLM_PROVIDER_DEV=gemini
# LLM_MODEL_DEV=gemini-2.5-flash

# Ejemplo 2: TODO CON OPENAI (mejor calidad, más caro)
# LLM_PROVIDER_ARCH=openai
# LLM_MODEL_ARCH=gpt-4o
# LLM_PROVIDER_DEV=openai
# LLM_MODEL_DEV=gpt-4o

# Ejemplo 3: HÍBRIDO (Arch con OpenAI, Dev con Gemini)
# LLM_PROVIDER_ARCH=openai
# LLM_MODEL_ARCH=gpt-4o-mini
# LLM_PROVIDER_DEV=gemini
# LLM_MODEL_DEV=gemini-2.5-flash

# Ejemplo 4: ECONÓMICO (GPT-4o-mini para todo)
# LLM_PROVIDER_ARCH=openai
# LLM_MODEL_ARCH=gpt-4o-mini
# LLM_PROVIDER_DEV=openai
# LLM_MODEL_DEV=gpt-4o-mini
