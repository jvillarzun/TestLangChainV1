# ── LLMs ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...  # legacy, no usado
ANTHROPIC_API_KEY=    # reservado para P3 dev-agent
GOOGLE_API_KEY=AIza...  # Motor LLM principal - obtener en https://aistudio.google.com/app/apikey
OPENAI_API_KEY=sk-proj-...  # OpenAI API Key - obtener en https://platform.openai.com/api-keys

# ── Multi-Provider (Arch & Dev) ───────────────────────────────────────────────
# Cambiar entre "gemini" y "openai" sin tocar código
LLM_PROVIDER_ARCH=openai
LLM_MODEL_ARCH=gpt-4o-mini

LLM_PROVIDER_DEV=openai
LLM_MODEL_DEV=gpt-4o-mini

# TEST_MODE=true → nodos usan stubs, no llaman al LLM
TEST_MODE=false
MOCK_EARLY_AGENTS=false

# ENABLE_BUILD_VALIDATION=true → Dev Agent valida builds y auto-sana errores
ENABLE_BUILD_VALIDATION=true

# ── Slack ──────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_TEAM_CHANNEL=C0XXXXXXX

# User IDs por rol (obtener desde Slack: perfil > ... > Copy member ID)
SLACK_USER_PO=U0XXXXXXX
SLACK_USER_ARCHITECT=U0YYYYYYY
SLACK_USER_DEV_LEAD=U0ZZZZZZZ
SLACK_USER_QA_LEAD=U0AAAAAAA
SLACK_USER_DEVOPS=U0BBBBBBB

# ── Jira ───────────────────────────────────────────────────────────────────────
JIRA_SERVER=https://your-org.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=MACH

# ── Webhook ────────────────────────────────────────────────────────────────────
# En Docker, usar la URL pública (cloudflared / ngrok) para que Slack pueda alcanzarla
WEBHOOK_BASE_URL=http://localhost:8000
WEBHOOK_PORT=8000
DASHBOARD_URL=http://localhost:8501

SHOW_MANUAL_CONTROLS=true

# ── LangSmith (observabilidad y tracing) ─────────────
# Obtener en https://smith.langchain.com → Settings → API Keys
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=mach-orchestrator

# ── Testing ───────────────────────────────────────────
# true → stubs en lugar de LLM, no gasta tokens. Ideal para probar HITL/Slack/Jira.
TEST_MODE=false

# ── Checkpointing ─────────────────────────────────────
# sqlite → persiste estado entre reinicios del proceso (recomendado)
# memory → sin persistencia, ciclo muere si el proceso se reinicia
CHECKPOINTER=sqlite
SQLITE_PATH=./mach_cycle.db

# ── GitHub ──────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_USERNAME=username
REPO_FE_NAME=mach-frontend-test-hackathon

# ── Confluence ──────────────────────────────────────────────────────────────────────────
# URL base de tu instancia Atlassian (mismo dominio que Jira)
CONFLUENCE_URL= # Ejemplo: https://sapo-re-frito.atlassian.net
# Mismo email y token que Jira
CONFLUENCE_EMAIL= # Ejemplo: sapo.re.frito@gmail.com
CONFLUENCE_API_TOKEN= # Sirve el mismo que el de jira. Se tiene que configurar confluence en la cuenta de Atlassian.
# Clave del Space en Confluence (créalo en tu Confluence primero)
CONFLUENCE_SPACE_KEY= # Ejemplo: MR
