# ── LLMs ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# ── Slack ─────────────────────────────────────────────
# Bot token de la Slack App (xoxb-...)
SLACK_BOT_TOKEN=xoxb-...
# Signing secret para verificar webhooks entrantes
SLACK_SIGNING_SECRET=...
# Canal del equipo para notificaciones generales
SLACK_TEAM_CHANNEL=C0XXXXXXX

# Usuarios por rol (obtener con /api/users.list)
SLACK_USER_PO=U0XXXXXXX
SLACK_USER_ARCHITECT=U0YYYYYYY
SLACK_USER_DEV_LEAD=U0ZZZZZZZ
SLACK_USER_QA_LEAD=U0AAAAAAA
SLACK_USER_DEVOPS=U0BBBBBBB

# ── Jira ──────────────────────────────────────────────
JIRA_SERVER=https://your-org.atlassian.net
JIRA_EMAIL=your-email@machbank.com
JIRA_API_TOKEN=ATATT...
# ID del proyecto en Jira (ej: MACH)
JIRA_PROJECT_KEY=MACH

# ── Webhook server ────────────────────────────────────
# URL pública donde Slack enviará los payloads de botones
# En dev: usar ngrok. En prod: URL del servidor
WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok.io
WEBHOOK_PORT=8000

# ── LangSmith (observabilidad y tracing) ─────────────
# Obtener en https://smith.langchain.com → Settings → API Keys
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=mach-orchestrator

# ── Checkpointing ─────────────────────────────────────
# Para dev: memory (sin persistencia entre reinicios)
# Para prod: sqlite o postgres
CHECKPOINTER=memory
# SQLITE_PATH=./mach_cycle.db
